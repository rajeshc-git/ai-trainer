# ─────────────────────────────────────────────────────────────
# AI Model Fine-Tuner — Environment Configuration
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Secret used to sign JWT tokens (change this in production!)
JWT_SECRET=change-me-in-production

# Redis connection (used internally by docker-compose service name)
REDIS_URL=redis://redis:6379/0

# Hugging Face cache directory (mapped inside the models volume)
HF_HOME=/models/.hf_cache

# Optional: a Hugging Face access token for gated/private models.
# Leave blank for public models. Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Expose all GPUs to the backend container
NVIDIA_VISIBLE_DEVICES=all

# Frontend → backend base URL (used by the browser)
VITE_API_BASE=http://localhost:8000
